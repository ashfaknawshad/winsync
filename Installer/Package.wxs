<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    Per-user install (no admin rights needed, matching the app's own "no admin
    rights" promise). Payload is the framework-dependent publish output
    (Properties/PublishProfiles/Installer-win-x64.pubxml) — a few hundred KB,
    not the ~70MB self-contained build. If the .NET 8 Desktop Runtime isn't
    present, the app's own apphost shows Microsoft's standard "install the
    runtime" prompt on first launch, so no custom launch condition is needed
    here.
  -->
  <Package Name="WinSync"
           Manufacturer="Ashfak Nawshad"
           Version="1.0.0"
           UpgradeCode="c198ef92-c5b9-4b9e-aa13-b1a77711311f"
           Scope="perUser"
           InstallerVersion="500">

    <SummaryInformation Description="WinSync installer" Manufacturer="Ashfak Nawshad" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of WinSync is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="WinSyncIcon.ico" SourceFile="..\Assets\winsync.ico" />
    <Property Id="ARPPRODUCTICON" Value="WinSyncIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ashfaknawshad/winsync" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ashfaknawshad/winsync" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="WinSync">
        <Component Id="MainExecutable" Guid="8f2c6d1a-8f0a-4a3a-9f4a-1a2f6b8c9d10">
          <!--
            Per-user (HKCU) components must key off the registry, not the file
            itself (ICE38/ICE43), and the profile directory needs an explicit
            removal entry on uninstall (ICE64).
          -->
          <RegistryValue Root="HKCU" Key="Software\WinSync" Name="Installed"
                          Type="integer" Value="1" KeyPath="yes" />
          <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
          <File Id="WinSyncExe"
                Source="..\bin\publish\installer-win-x64\WinSync.exe">
            <Shortcut Id="StartMenuShortcut"
                      Directory="ProgramMenuFolder"
                      Name="WinSync"
                      WorkingDirectory="INSTALLFOLDER"
                      Advertise="no" />
          </File>
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="MainFeature" Title="WinSync" Level="1">
      <ComponentRef Id="MainExecutable" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
