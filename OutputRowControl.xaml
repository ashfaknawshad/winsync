<UserControl x:Class="WinSync.OutputRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="584" Height="180">
    <Border Style="{StaticResource CardStyle}">
        <Canvas>
            <Border Style="{StaticResource NumberBadgeStyle}" Canvas.Left="18" Canvas.Top="16">
                <TextBlock x:Name="BadgeText" Style="{StaticResource NumberBadgeText}" />
            </Border>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}" Canvas.Left="50" Canvas.Top="18" />

            <!-- Live buffer readout, shown only while running — sits here in the
                 header row rather than colliding with the Volume label below,
                 which is the exact bug that prompted the last redesign. -->
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}"
                       Width="200" TextAlignment="Right" Visibility="Collapsed"
                       Canvas.Left="320" Canvas.Top="20" />

            <ToggleButton x:Name="EnableToggle" Style="{StaticResource ToggleSwitchStyle}"
                          Canvas.Left="534" Canvas.Top="15" />

            <ComboBox x:Name="DeviceCombo" Style="{StaticResource MacComboBox}" Width="548"
                      Canvas.Left="18" Canvas.Top="46" />

            <TextBlock Text="Delay" Style="{StaticResource LabelText}" Canvas.Left="18" Canvas.Top="88" />
            <TextBlock x:Name="DelayValueText" Text="0 ms" Style="{StaticResource ValueText}"
                       Width="80" TextAlignment="Right" Canvas.Left="398" Canvas.Top="86" />
            <Slider x:Name="DelaySlider" Style="{StaticResource MacSliderStyle}" Width="460"
                    Minimum="0" Maximum="1000" Value="0" Canvas.Left="18" Canvas.Top="104" />

            <TextBlock Text="Volume" Style="{StaticResource LabelText}" Canvas.Left="18" Canvas.Top="132" />
            <TextBlock x:Name="VolumeValueText" Text="100%" Style="{StaticResource ValueText}"
                       Width="80" TextAlignment="Right" Canvas.Left="398" Canvas.Top="130" />
            <Slider x:Name="VolumeSlider" Style="{StaticResource MacSliderStyle}" Width="460"
                    Minimum="0" Maximum="100" Value="100" Canvas.Left="18" Canvas.Top="148" />
        </Canvas>
    </Border>
</UserControl>
