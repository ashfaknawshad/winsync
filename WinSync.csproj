<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WinSync</AssemblyName>
    <RootNamespace>WinSync</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\winsync.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <Product>WinSync</Product>
    <AssemblyTitle>WinSync</AssemblyTitle>
    <Description>Play the same system audio through two headphones on Windows, with per-device delay and drift correction.</Description>
    <Version>1.0.1</Version>
    <FileVersion>1.0.1.0</FileVersion>
  </PropertyGroup>

  <!--
    Two publish shapes, selected with `dotnet publish -p:PublishProfile=<Name>`
    (see Properties/PublishProfiles):
      Portable-win-x64   self-contained single exe, no prerequisites, ~70MB
      Installer-win-x64  framework-dependent, tiny — payload for the MSI,
                         requires the .NET 8 Desktop Runtime on the machine
    Plain `dotnet build`/`dotnet run` stay framework-dependent and non-single-file
    for a fast inner dev loop.
  -->

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
